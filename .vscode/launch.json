    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "env": {"LOG_LEVEL":"INFO","CUDA_VISIBLE_DEVICES": "7"},
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "accelerate train",
            "type": "debugpy",
            "request": "launch",
            "env": {"LOG_LEVEL":"INFO"}, //,"CUDA_VISIBLE_DEVICES": "4,5,6,7"},
            "module": "accelerate.commands.launch",
            "args": ["--config_file", "configs/acc_config/47.yaml", "train.py",
            "--config", "configs/exp26.yaml",
            "--expname", "test", 
            "--restore_step", "-1","--split",
            "--distill_model_path","/data/megastore/SHARE/TTS/LAM_TTS/latest/checkpoints/acoustics/lamtts/exp24_ft_randspk"
        ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
    ]
